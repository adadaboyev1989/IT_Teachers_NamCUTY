# Copy to .env.local to point the frontend at the local SQLite dev server
# (npm run dev:server / npm run dev:local) instead of real Supabase.
# Any value works for the anon key — the local server doesn't check it.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-dev-anon-key

# Optional: override the local admin login (defaults shown below).
# LOCAL_ADMIN_EMAIL=admin@it-teachers.uz
# LOCAL_ADMIN_PASSWORD=localdev123
